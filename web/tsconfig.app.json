{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/lib/hosted-files/core": [
        "./src/hosted/core/index.ts"
      ],
      "@/lib/hosted-files/react": [
        "./src/hosted/react/index.ts"
      ],
      "@/lib/utils": [
        "./src/hosted/shims/utils.ts"
      ],
      "sonner": [
        "./src/hosted/shims/sonner.ts"
      ],
      "@bam/ui": [
        "../studio/packages/bam-ui/src/index.ts"
      ],
      "@bam/ui/*": [
        "../studio/packages/bam-ui/src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "@base-ui/react": [
        "./node_modules/@base-ui/react"
      ],
      "@base-ui/react/*": [
        "./node_modules/@base-ui/react/*"
      ],
      "cmdk": [
        "./node_modules/cmdk"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ]
    }
  },
  "include": [
    "src"
  ]
}