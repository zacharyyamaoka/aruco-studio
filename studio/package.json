{
  "name": "aruco-studio",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "ArUco Studio: the 2D / 3D web app on the Studio's API (127.0.0.1:5360).",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5361 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5361 --strictPort",
    "test": "vitest run",
    "types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
    "e2e": "npm --prefix ../e2e test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
