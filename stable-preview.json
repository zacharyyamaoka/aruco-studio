{
  "app": "aruco-studio",
  "name": "ArUco Studio",
  "icon": "web/public/icon.svg",
  "mainBranch": "main",
  "stable": {
    "port": 5382,
    "build": [
      ["node", "{source}/web/scripts/pack-core.mjs"],
      ["node", "{assets}/vite/build.mjs", "--root", "{source}/web", "--out-dir", "{source}/web/dist"]
    ],
    "output": "web/dist"
  },
  "preview": {
    "port": 5383,
    "command": ["node", "{assets}/vite/serve.mjs", "--root", "{checkout}", "--vite-root", "{checkout}/web", "--port", "{port}", "--host", "127.0.0.1"],
    "processes": [
      {
        "name": "pack",
        "port": 5384,
        "command": ["sh", "-c", "node web/scripts/pack-core.mjs && exec python3 -m http.server {port} --bind 127.0.0.1 --directory web/public/py"],
        "watch": ["aruco_studio/**/*.py"]
      }
    ]
  },
  "snapshot": {
    "exclude": [
      "/docs/", "/reports/", "/tests/", "/e2e/", "/goldens/", "/examples/", "/tools/", "/web/e2e/",
      "/aruco_studio/server/", "/aruco_studio/adapters/", "/aruco_studio/verify/", "/aruco_studio/__main__.py",
      "/studio/src/", "/studio/scripts/", "/studio/index.html", "/studio/package.json", "/studio/package-lock.json",
      "/studio/tsconfig*.json", "/studio/vite.config.ts", "/studio/vitest.config.ts",
      "/README.md", "/pyproject.toml", "/requirements.txt", "/.gitattributes"
    ],
    "link": ["web/node_modules"]
  }
}
