{
  "name": "aruco-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The online ArUco Studio (arucostudio.com): a static site; the Python core runs in the browser (Pyodide). docs/design/online_studio_v1.md",
  "scripts": {
    "pack-core": "node scripts/pack-core.mjs",
    "dev": "npm run pack-core && vite --host 127.0.0.1 --port 5380 --strictPort",
    "build": "npm run pack-core && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5381 --strictPort",
    "test": "vitest run",
    "test:parity": "node scripts/parity.mjs",
    "e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@tailwindcss/vite": "4.3.3",
    "cmdk": "1.1.1",
    "lucide-react": "1.42.0",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
